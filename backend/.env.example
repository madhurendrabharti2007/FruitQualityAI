# Create a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# JWT signing secret for access tokens (REPLACE in production with a long random string)
JWT_SECRET=change-this-development-secret

# Admin token used for X-Admin-Token header on /fruits CRUD endpoints
ADMIN_TOKEN=fruit-admin

# ESP32-CAM / hardware device auth key for /api/hardware-predict
HARDWARE_DEVICE_KEY=esp32-cam-default-key

# Comma-separated list of allowed frontend origins (CORS)
# For local dev these are already included by default.
# For production set this to your Vercel frontend URL, e.g.:
#   ALLOWED_ORIGINS=https://fruitqualityai.vercel.app
# Multiple origins example:
#   ALLOWED_ORIGINS=https://fruitqualityai.vercel.app,https://app.example.com
ALLOWED_ORIGINS=

# Optional: set to "true" to allow all origins (disables credentials)
CORS_ALLOW_ALL=

# Optional: override SQLite DB path or directory
# DATABASE_URL=sqlite:////data/fruit_quality.db
# SQLITE_DB_DIR=/data

# Optional: override upload directory
# UPLOAD_DIR=/data/uploads
